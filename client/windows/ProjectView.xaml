<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAF9F8" TextElement.FontFamily="Microsoft YaHei UI" TextElement.Foreground="#302A30"
      TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#302A30"/>
            <Setter Property="BorderBrush" Value="#E3DCDF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#AC7387"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#80334F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
            <Button x:Name="Import" Content="导入项目目录…" Foreground="White" Background="#853650" BorderBrush="#853650"/>
            <Button x:Name="Open" Content="打开资料库" Margin="7,0,0,0"/>
            <Button x:Name="More" Content="更多 ▾" Margin="7,0,0,0" AutomationProperties.Name="更多项目操作"/>
        </StackPanel>
        <Border BorderBrush="#E4DFE1" BorderThickness="1" CornerRadius="7" Background="White" Padding="10,3">
            <DockPanel>
                <Path DockPanel.Dock="Left" Margin="0,0,8,0" Width="15" Height="15" Stroke="#786D75" StrokeThickness="1.7"
                      Stretch="Uniform" Data="M10.5,10.5 L16,16 M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7"/>
                <Grid>
                    <TextBox x:Name="Search" AutomationProperties.Name="搜索项目" Padding="0" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" FontSize="13"/>
                    <TextBlock x:Name="SearchHint" Text="搜索项目" Foreground="#786D75" IsHitTestVisible="False" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
    <TextBlock x:Name="Warning" Grid.Row="1" TextWrapping="Wrap" Foreground="#854721" Margin="1,0,0,10" Visibility="Collapsed"/>
    <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="#E4DFE1" Background="White" Padding="5">
        <Grid>
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent" AutomationProperties.Name="项目列表"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="11,9"/>
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="7" Background="Transparent" BorderThickness="1"
                                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F8F5F6"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#F4E7EC"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#AA7186"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Details}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F4E6EB" CornerRadius="8" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Stroke="#8A455F" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform"
                                      Width="18" Height="16" Data="M1,4 H7 L9,6 H18 V16 H1 Z M1,7.5 H18"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Location}" Foreground="#716670" FontSize="11" Margin="0,3,0,0" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nas}" Foreground="#783B54" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LastActivity}" FontSize="11" Margin="0,3,0,0" Foreground="#716670" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Git}" FontSize="12" Foreground="#5D535A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="Empty" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                <TextBlock x:Name="EmptyTitle" Text="还没有项目" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="配对 NAS 后，导入包含项目的父目录。" Margin="0,7,0,0" Foreground="#716670" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
    <TextBlock x:Name="Detail" Grid.Row="3" Margin="2,8,2,1" Foreground="#716670" FontSize="12" TextTrimming="CharacterEllipsis"/>
</Grid>
