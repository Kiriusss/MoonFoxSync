<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
              Focusable="False" Background="#FAF9F8" TextElement.FontFamily="Microsoft YaHei UI"
              TextElement.Foreground="#302A30" TextOptions.TextFormattingMode="Display"
              UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer.Resources>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#302A30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4DFE1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#F8EFF1"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#CDA7B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#EEDDE2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#983E57"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value=".65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="17,12"/>
            <Setter Property="MinHeight" Value="84"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#70676D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#302A30"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Stroke" Value="#983E57"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </ScrollViewer.Resources>
    <StackPanel Margin="0,0,3,12">
        <Border CornerRadius="15" Padding="24,17">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#312633" Offset="0"/>
                    <GradientStop Color="#593E50" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width=".65*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#F5B5BC" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ConnectionLabel" Text="正在检查连接" Foreground="#F1E8ED" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="梦枢天罗" Foreground="White" FontWeight="Bold" FontSize="28" Margin="0,3,0,0"/>
                    <TextBlock x:Name="Endpoint" Text="使用 NAS 签发的配对码连接" Foreground="#E3D5DD" FontSize="13"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,12"/>
                    <Button x:Name="ServerAction" Style="{StaticResource ButtonBase}"
                            Content="配对 NAS" HorizontalAlignment="Left" Padding="14,5" FontWeight="SemiBold"/>
                </StackPanel>
                <!-- Same three-bay NAS geometry as VaultIllustration in the Mac client. -->
                <Viewbox Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Right" Width="Auto" MaxWidth="242"
                         Height="134" IsHitTestVisible="False" Focusable="False">
                    <Canvas Width="240" Height="145">
                        <Path Stroke="#5A4557" StrokeThickness="1" StrokeDashArray="3 4"
                              Data="M20,105 l57,31 42,-23 M56,105 l57,31 42,-23 M92,105 l57,31 42,-23 M128,105 l57,31 42,-23"/>
                        <Path Stroke="#E1ADBB" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="#705466"
                              Data="M40,39 L99,11 197,37 138,67 Z"/>
                        <Path Stroke="#E1ADBB" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="#402E3D"
                              Data="M138,67 L197,37 197,101 138,133 Z"/>
                        <Path Stroke="#E1ADBB" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="#574052"
                              Data="M40,39 L138,67 138,133 40,103 Z"/>
                        <Path Stroke="#BD91A3" StrokeThickness="1.25" StrokeLineJoin="Round" Fill="#402E3D"
                              Data="M49,48 l17,5 0,48 -17,-5 Z M72,55 l17,5 0,48 -17,-5 Z M95,62 l17,5 0,48 -17,-5 Z"/>
                        <Path Stroke="#BF94A5" StrokeThickness="1.6" Data="M54,58 v29 M77,65 v29 M100,72 v29"/>
                        <Path Stroke="#916D83" StrokeThickness="1.3" Data="M151,83 v23 M157,80 v23 M163,77 v23 M169,74 v23"/>
                        <StackPanel Canvas.Left="122" Canvas.Top="90" x:Name="Leds">
                            <StackPanel.Resources>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Width" Value="3.6"/>
                                    <Setter Property="Height" Value="3.6"/>
                                    <Setter Property="Margin" Value="0,0,0,3.4"/>
                                    <Setter Property="Fill" Value="{Binding}"/>
                                </Style>
                            </StackPanel.Resources>
                            <Ellipse/><Ellipse/><Ellipse/>
                        </StackPanel>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
        <UniformGrid Columns="3" Margin="0,15,0,0">
            <Button x:Name="Libraries" Style="{StaticResource MetricButton}" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="M1,5 L9,1 17,5 9,9 Z M1,9 l8,4 8,-4 M1,13 l8,4 8,-4"/>
                        <TextBlock Text="资料库" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock x:Name="LibraryCount" Text="—" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Button>
            <Button x:Name="Queue" Style="{StaticResource MetricButton}" Margin="4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="M9,13 V1 M4,6 L9,1 14,6 M2,13 v3 h14 v-3"/>
                        <TextBlock Text="待上传快照" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock x:Name="QueueCount" Text="—" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Button>
            <Button x:Name="Settings" Style="{StaticResource MetricButton}" Margin="6,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Glyph}" Data="M2,7 A7,7 0 0 1 14,4 L16,6 M16,2 v4 h-4 M16,11 A7,7 0 0 1 4,14 L2,12 M2,16 v-4 h4"/>
                        <TextBlock Text="自动同步" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock x:Name="SyncMode" Text="—" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Button>
        </UniformGrid>
        <DockPanel Margin="0,19,0,10">
            <Button x:Name="AllProjects" Style="{StaticResource ButtonBase}" DockPanel.Dock="Right" Content="查看全部"
                    Foreground="#963A54" Background="Transparent" BorderBrush="Transparent"/>
            <TextBlock Text="最近活动的项目" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Border x:Name="EmptyPanel" BorderBrush="#E7E2E2" BorderThickness="1" CornerRadius="12" Background="White" Padding="18,15">
            <DockPanel>
                <Border Width="44" Height="44" VerticalAlignment="Top" CornerRadius="11" Background="#F5F2F2" Margin="0,1,14,0" DockPanel.Dock="Left">
                    <Path Style="{StaticResource Glyph}" Width="23" Height="23" Margin="0" Stroke="#746972"
                          Data="M1,4 h6 l2,3 h9 v10 h-17 Z M2,7 h16"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="正在读取项目状态" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmptyMessage" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="Import" Visibility="Collapsed" Style="{StaticResource ButtonBase}" Content="导入项目目录…"
                            HorizontalAlignment="Left" Margin="0,9,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ItemsControl x:Name="RecentItems" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ButtonBase}" Margin="0,0,0,3" Padding="15,10"
                            AutomationProperties.Name="{Binding Description}" Tag="{Binding Unit}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width=".8*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Nas}" ToolTip="{Binding Nas}" Foreground="#983E57" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Git}" ToolTip="{Binding Git}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ProjectsWarning" FontSize="12" Foreground="#854721" Visibility="Collapsed" Margin="0,6" TextWrapping="Wrap"/>
    </StackPanel>
</ScrollViewer>
